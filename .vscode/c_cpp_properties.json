{
    "version": 4,
    "configurations": [
        {
            "name": "Host",
            "compilerPath": "/usr/bin/clang++",
            "intelliSenseMode": "${default}",
            "forcedInclude": [
                "${workspaceFolder}/include/vscode_fix.hpp"
            ],
            "compileCommands": [
                "${workspaceFolder}/out/build/debug/compile_commands.json"
            ],
            "includePath": [
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/source/**",
                "${workspaceFolder}/out/build/debug/aegis_flatbuffers",
                "${workspaceFolder}/libs/entt/src",
                "${workspaceFolder}/libs/flatbuffers/include",
                "${workspaceFolder}/libs/etl/include",
                "${workspaceFolder}/libs/fpm/include"
            ],
            "cStandard": "c11",
            "cppStandard": "c++20"
        }
    ]
}

{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}"
        },
        {
            "name": "debug",
            "displayName": "Aegis Engine (Debug)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Aegis Engine (Release)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "default",
            "displayName": "Default (Debug)",
            "inherits": "debug"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Build Aegis Engine (Debug)",
            "configurePreset": "debug",
            "targets": [
                "aegis_engine"
            ]
        },
        {
            "name": "release",
            "displayName": "Build Aegis Engine (Release)",
            "configurePreset": "release",
            "targets": [
                "aegis_engine"
            ]
        },
        {
            "name": "default",
            "displayName": "Default (Debug)",
            "inherits": "debug"
        }
    ]
}
